<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3PM · Round 1 – Team Battle</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Bubblegum+Sans&display=swap" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Bubblegum Sans', cursive;
    background: linear-gradient(135deg, #FFD700, #FFA500);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 20px 20px 0;
    overflow: auto;
}

/* ================= TIMER BAR ================= */
.timer-container {
    position: fixed;
    right: 0;
    top: 0;
    height: 100vh;
    width: 18px;
    background: rgba(0,0,0,0.15);
    z-index: 100;
}

.timer-bar {
    width: 100%;
    height: 0%;
    background: #00FF00;
    position: absolute;
    top: 0;
    left: 0;
    animation: countdown 600s linear forwards;
}

@keyframes countdown {
    from { height: 0%; }
    to { height: 100%; }
}

/* ================= MAIN CARD ================= */
.question-container {
    background: white;
    border-radius: 20px;
    padding: 40px;
    max-width: 1200px;
    width: 95%;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    text-align: center;
    margin: 20px auto;
    max-height: 90vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
}

.question-container::-webkit-scrollbar {
    width: 12px;
}

.question-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.question-container::-webkit-scrollbar-thumb {
    background: #FF6B6B;
    border-radius: 10px;
}

.stage-title {
    font-family: 'Fredoka One', cursive;
    font-size: 48px;
    color: #FF6B6B;
    margin-bottom: 15px;
    flex-shrink: 0;
}

.stage-subtitle {
    font-size: 24px;
    margin-bottom: 25px;
    flex-shrink: 0;
}

.question-number {
    font-family: 'Fredoka One', cursive;
    font-size: 32px;
    color: #4ECDC4;
    margin-bottom: 20px;
    flex-shrink: 0;
}

.question-box {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 20px;
    padding: 40px;
    color: white;
    margin-bottom: 30px;
    flex-shrink: 0;
}

.original-sentence {
    font-size: 36px;
    margin-bottom: 25px;
    line-height: 1.5;
    word-wrap: break-word;
    font-weight: bold;
}

.change-instruction {
    font-family: 'Fredoka One', cursive;
    font-size: 28px;
    color: #FFD700;
    word-wrap: break-word;
}

.answer-section {
    background: #f8f9fa;
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 30px;
    display: none;
    max-height: 400px;
    overflow-y: auto;
    flex-shrink: 0;
}

.answer-section::-webkit-scrollbar {
    width: 10px;
}

.answer-section::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.answer-section::-webkit-scrollbar-thumb {
    background: #4ECDC4;
    border-radius: 10px;
}

.answer-label {
    font-family: 'Fredoka One', cursive;
    font-size: 32px;
    color: #4ECDC4;
    margin-bottom: 20px;
}

.answer-text {
    font-size: 36px;
    color: #2c3e50;
    padding: 25px;
    background: white;
    border-radius: 15px;
    border: 4px solid #4ECDC4;
    word-wrap: break-word;
    font-weight: bold;
}

.controls {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 15px;
    padding: 20px 0 10px 0;
    background: white;
    border-top: 3px solid #f0f0f0;
    flex-shrink: 0;
    position: sticky;
    bottom: 0;
    z-index: 10;
}

.control-btn {
    font-family: 'Fredoka One', cursive;
    font-size: 28px;
    padding: 20px 45px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    color: white;
    text-transform: uppercase;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    transition: all 0.3s ease;
    min-width: 200px;
}

.control-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}

.btn-show { background: linear-gradient(145deg, #4ECDC4, #44A08D); }
.btn-next { background: linear-gradient(145deg, #FFD700, #FFA500); }
.btn-home { background: linear-gradient(145deg, #95a5a6, #7f8c8d); }

.hidden { display: none !important; }

.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 1000;
    justify-content: center;
    align-items: center;
}

.modal-content {
    background: white;
    padding: 50px;
    border-radius: 40px;
    text-align: center;
    max-width: 600px;
    width: 90%;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    animation: modalPop 0.5s ease-out;
}

@keyframes modalPop {
    0% {
        transform: scale(0.5);
        opacity: 0;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

.modal-icon {
    font-size: 100px;
    margin-bottom: 25px;
    animation: shake 0.5s ease-in-out;
}

@keyframes shake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-10deg); }
    75% { transform: rotate(10deg); }
}

.modal-content h2 {
    font-family: 'Fredoka One', cursive;
    font-size: 56px;
    color: #FF6B6B;
    margin-bottom: 25px;
}

.modal-content p {
    font-size: 28px;
    margin-bottom: 35px;
    color: #333;
}

.modal-btn {
    font-family: 'Fredoka One', cursive;
    font-size: 28px;
    padding: 18px 60px;
    background: linear-gradient(145deg, #FF6B6B, #EE5A6F);
    border: none;
    border-radius: 60px;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

.modal-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

@media (max-width: 1024px) and (min-width: 768px) {
    .stage-title {
        font-size: 42px;
    }
    
    .original-sentence {
        font-size: 32px;
    }
    
    .answer-text {
        font-size: 32px;
    }
    
    .control-btn {
        font-size: 24px;
        padding: 16px 35px;
        min-width: 180px;
    }
}

@media (max-width: 767px) {
    .stage-title {
        font-size: 36px;
    }
    
    .original-sentence { 
        font-size: 28px; 
    }
    
    .answer-text {
        font-size: 28px;
    }
    
    .control-btn {
        font-size: 22px;
        padding: 15px 30px;
        min-width: 160px;
    }
}
</style>
</head>

<body>

<div class="timer-container">
    <div class="timer-bar"></div>
</div>

<div class="question-container">
    <h1 class="stage-title">🏆 Round 1: Team Battle</h1>
    <p class="stage-subtitle">Most correct answers wins!</p>

    <div class="question-number" id="questionNumber"></div>

    <div class="question-box">
        <div class="original-sentence" id="originalSentence">Loading questions...</div>
        <div class="change-instruction" id="changeInstruction"></div>
    </div>

    <div class="answer-section" id="answerSection">
        <div class="answer-label">✓ Correct Answer</div>
        <div class="answer-text" id="answerText"></div>
    </div>

    <div class="controls">
        <button class="control-btn btn-show" id="showAnswerBtn">Show Answer</button>
        <button class="control-btn btn-next hidden" id="nextBtn">Next</button>
        <button class="control-btn btn-home" onclick="location.href='index.html'">Home</button>
    </div>
</div>

<div class="modal-overlay" id="timesUpModal">
    <div class="modal-content">
        <div class="modal-icon">⏰</div>
        <h2>TIME'S UP!</h2>
        <p>The round has ended</p>
        <button class="modal-btn" id="modalOkBtn">OK</button>
    </div>
</div>

<script>
// Sentence Master Challenge – Week of October 19–22, 2026
// 48 hard-coded questions per class; no external CSV files are required.
const SM_DATA_BY_CLASS = {
    "3pm": "question #\toriginal sentence\tchange to\tanswer\n1\tThe woman is surprised.\tThey\tThey are surprised.\n2\tMy grandfather waters the plants every morning.\tYesterday\tMy grandfather watered the plants yesterday.\n3\tThere is a scarf on the sofa.\tPlural\tThere are scarves on the sofa.\n4\tChloe listens to music before bed.\tNegative\tChloe doesn’t listen to music before bed.\n5\tThe children are building a tower.\tQuestion\tAre the children building a tower?\n6\tI have an old bicycle.\tShe\tShe has an old bicycle.\n7\tThe boys feed the ducks on Sundays.\tNow\tThe boys are feeding the ducks now.\n8\tMason can fix the chair.\tNegative\tMason can’t fix the chair.\n9\tElla takes the subway to school.\tQuestion\tDoes Ella take the subway to school?\n10\tThe café is busy today.\tYesterday\tThe café was busy yesterday.\n11\tWe made sandwiches yesterday.\tEvery Saturday\tWe make sandwiches every Saturday.\n12\tOliver has a new helmet.\tThey\tThey have a new helmet.\n13\tThe woman is carrying a heavy box.\tQuestion\tIs the woman carrying a heavy box?\n14\tMy cousin takes piano lessons every Tuesday.\tYesterday\tMy cousin took a piano lesson yesterday.\n15\tThere is a child near the gate.\tPlural\tThere are children near the gate.\n16\tEthan enjoys reading before bed.\tNegative\tEthan doesn’t enjoy reading before bed.\n17\tThe boys are fixing their bicycles.\tYesterday\tThe boys fixed their bicycles yesterday.\n18\tI have a ticket for the concert.\tShe\tShe has a ticket for the concert.\n19\tThe students usually eat lunch outside.\tNow\tThe students are eating lunch outside now.\n20\tMia can solve this problem.\tNegative\tMia can’t solve this problem.\n21\tLucas visits his grandparents every month.\tQuestion\tDoes Lucas visit his grandparents every month?\n22\tThe shop is crowded today.\tYesterday\tThe shop was crowded yesterday.\n23\tWe drove to the lake yesterday.\tEvery summer\tWe drive to the lake every summer.\n24\tThe baby has a blue blanket.\tThey\tThey have blue blankets.\n25\tI usually eat breakfast at seven.\tYesterday\tI ate breakfast at seven yesterday.\n26\tShe buys new shoes every year.\tYesterday\tShe bought new shoes yesterday.\n27\tThey are waiting for the bus.\tQuestion\tAre they waiting for the bus?\n28\tHe drinks coffee every morning.\tNegative\tHe doesn’t drink coffee every morning.\n29\tI do my homework after dinner.\tHe\tHe does his homework after dinner.\n30\tMy brother can swim very well.\tNegative\tMy brother can’t swim very well.\n31\tWe visit the museum every Saturday.\tLast Saturday\tWe visited the museum last Saturday.\n32\tThere is a book on the table.\tThree\tThere are three books on the table.\n33\tShe gets to school by bus.\tHow\tHow does she get to school?\n34\tTom wears a blue jacket.\tNow\tTom is wearing a blue jacket now.\n35\tEmma reads before bed.\tNegative\tEmma doesn’t read before bed.\n36\tIt was raining. We stayed home.\tbecause\tWe stayed home because it was raining.\n37\tMy sister rides her bike to school.\tYesterday\tMy sister rode her bike to school yesterday.\n38\tThe man is carrying two boxes.\tQuestion\tIs the man carrying two boxes?\n39\tThere is a knife on the table.\tPlural\tThere are knives on the table.\n40\tJulia studies in the library after school.\tNegative\tJulia doesn’t study in the library after school.\n41\tI have a black umbrella.\tHe\tHe has a black umbrella.\n42\tThe children play near the river on Sundays.\tNow\tThe children are playing near the river now.\n43\tMarcus can answer the question.\tNegative\tMarcus can’t answer the question.\n44\tHelen visits her cousin every month.\tQuestion\tDoes Helen visit her cousin every month?\n45\tThe market is crowded today.\tYesterday\tThe market was crowded yesterday.\n46\tWe took photos yesterday.\tEvery holiday\tWe take photos every holiday.\n47\tLiam has a new pair of glasses.\tThey\tThey have new pairs of glasses.\n48\tThe bus was late. We waited outside.\tbecause\tWe waited outside because the bus was late.",
    "4pm": "question #\toriginal sentence\tchange to\tanswer\n1\tAmelia checks her email every morning.\tYesterday\tAmelia checked her email yesterday.\n2\tThey bought new shoes last week.\tNext week\tThey will buy new shoes next week.\n3\tLucas enjoys taking photos of nature.\tNegative\tLucas doesn’t enjoy taking photos of nature.\n4\tHannah is speaking to the receptionist.\tQuestion\tIs Hannah speaking to the receptionist?\n5\tThe task was difficult. We completed it on time.\tbut\tThe task was difficult, but we completed it on time.\n6\tAva missed the bus. She left home late.\tbecause\tAva missed the bus because she left home late.\n7\tThis suitcase is large. That suitcase is small.\tthan\tThis suitcase is larger than that suitcase.\n8\tNoah is going to paint his bedroom.\tQuestion\tIs Noah going to paint his bedroom?\n9\tI usually wear sneakers to work.\tYesterday\tI wore sneakers to work yesterday.\n10\tThis jacket is expensive. That jacket is cheap.\tthan\tThis jacket is more expensive than that jacket.\n11\tWe should arrive before nine.\tQuestion\tShould we arrive before nine?\n12\tGrace packed her bag. Then she called a taxi.\tafter\tGrace called a taxi after she packed her bag.\n13\tClara sends messages to her friends every evening.\tLast night\tClara sent messages to her friends last night.\n14\tThey met their teacher yesterday.\tTomorrow\tThey will meet their teacher tomorrow.\n15\tJacob enjoys learning how things work.\tNegative\tJacob doesn’t enjoy learning how things work.\n16\tEmma is looking for her keys.\tQuestion\tIs Emma looking for her keys?\n17\tThe weather was cold. We went for a walk.\tbut\tThe weather was cold, but we went for a walk.\n18\tLiam took an umbrella. The sky looked dark.\tbecause\tLiam took an umbrella because the sky looked dark.\n19\tThis computer is fast. That computer is slow.\tthan\tThis computer is faster than that computer.\n20\tRuby is going to cook dinner tonight.\tQuestion\tIs Ruby going to cook dinner tonight?\n21\tI usually speak to him after class.\tYesterday\tI spoke to him after class yesterday.\n22\tThis movie is interesting. That movie is boring.\tthan\tThis movie is more interesting than that movie.\n23\tYou should check the address first.\tQuestion\tShould you check the address first?\n24\tOliver finished the meeting. Then he went home.\tafter\tOliver went home after he finished the meeting.\n25\tDaniel takes the train to work every day.\tYesterday\tDaniel took the train to work yesterday.\n26\tI meet my friends every Friday.\tLast night\tI met my friends last night.\n27\tThey travel every summer.\tNext weekend\tThey will travel next weekend.\n28\tShe went out. She was tired.\tbecause\tShe went out because she was tired.\n29\tThis jacket is cheap. That jacket is expensive.\tthan\tThis jacket is cheaper than that jacket.\n30\tYou leave at eight.\tshould\tYou should leave at eight.\n31\tHe ate dinner. Then he finished his homework.\tafter\tHe finished his homework after he ate dinner.\n32\tYou have been to Japan.\tQuestion\tHave you been to Japan?\n33\tMy phone is expensive. Your phone is cheap.\tthan\tMy phone is more expensive than your phone.\n34\tShe cooked dinner. She listened to music.\twhile\tShe listened to music while she was cooking dinner.\n35\tThe room is small for everyone.\tnot enough\tThe room isn’t big enough for everyone.\n36\tThis book is interesting.\tI think...\tI think this book is interesting.\n37\tRebecca reads the news every morning.\tYesterday\tRebecca read the news yesterday.\n38\tThey drove to the mountains last weekend.\tNext weekend\tThey will drive to the mountains next weekend.\n39\tSamuel enjoys working in quiet places.\tNegative\tSamuel doesn’t enjoy working in quiet places.\n40\tChloe is choosing a new laptop.\tQuestion\tIs Chloe choosing a new laptop?\n41\tThe café was full. We found a seat.\tbut\tThe café was full, but we found a seat.\n42\tHenry went home early. He felt sick.\tbecause\tHenry went home early because he felt sick.\n43\tThis river is wide. That river is narrow.\tthan\tThis river is wider than that river.\n44\tMegan is going to take a driving test.\tQuestion\tIs Megan going to take a driving test?\n45\tI usually catch the 8:00 bus.\tYesterday\tI caught the 8:00 bus yesterday.\n46\tThis problem is complicated. That problem is simple.\tthan\tThis problem is more complicated than that problem.\n47\tYou should speak more slowly.\tQuestion\tShould you speak more slowly?\n48\tAaron locked the door. Then he left the building.\tafter\tAaron left the building after he locked the door.",
    "5pm": "question #\toriginal sentence\tchange to\tanswer\n1\tI like watermelon.\tHe\tHe likes watermelon.\n2\tSophie has a pink ruler.\tThey\tThey have a pink ruler.\n3\tThe lamp is next to the bed.\tPlural\tThe lamps are next to the bed.\n4\tWe open the windows every morning.\tYesterday\tWe opened the windows yesterday.\n5\tShe is tying her shoes.\tQuestion\tIs she tying her shoes?\n6\tLeo likes soup.\tNegative\tLeo doesn’t like soup.\n7\tThere are four plates on the table.\tSingular\tThere is a plate on the table.\n8\tThey wash the car on Saturday.\tNow\tThey are washing the car now.\n9\tMia can climb the tree.\tNegative\tMia can’t climb the tree.\n10\tRyan eats lunch at school.\tQuestion\tDoes Ryan eat lunch at school?\n11\tI was hungry yesterday.\tToday\tI am hungry today.\n12\tWe have rice. We have chicken.\tand\tWe have rice and chicken.\n13\tI like peaches.\tShe\tShe likes peaches.\n14\tDaniel has a white eraser.\tThey\tThey have white erasers.\n15\tThe picture is above the desk.\tPlural\tThe pictures are above the desk.\n16\tWe call our grandma every Sunday.\tYesterday\tWe called our grandma yesterday.\n17\tHe is putting on his jacket.\tQuestion\tIs he putting on his jacket?\n18\tLily likes cheese.\tNegative\tLily doesn’t like cheese.\n19\tThere are five books on the shelf.\tSingular\tThere is a book on the shelf.\n20\tThey clean the windows on Saturday.\tNow\tThey are cleaning the windows now.\n21\tMax can catch the ball.\tNegative\tMax can’t catch the ball.\n22\tAnna eats breakfast at home.\tQuestion\tDoes Anna eat breakfast at home?\n23\tI was nervous yesterday.\tToday\tI am nervous today.\n24\tWe have juice. We have cookies.\tand\tWe have juice and cookies.\n25\tI like apples.\tHe\tHe likes apples.\n26\tThe cat is under the chair.\tPlural\tThe cats are under the chair.\n27\tWe walk to school.\tYesterday\tWe walked to school yesterday.\n28\tShe eats lunch at school.\tNow\tShe is eating lunch at school now.\n29\tI can ride a bike.\tNegative\tI can’t ride a bike.\n30\tAmy has a red bag.\tThey\tThey have a red bag.\n31\tThey play soccer after school.\tQuestion\tDo they play soccer after school?\n32\tTom likes milk.\tNegative\tTom doesn’t like milk.\n33\tThere is a cup on the table.\tTwo\tThere are two cups on the table.\n34\tHe goes to bed at nine.\tWhen\tWhen does he go to bed?\n35\tI was happy yesterday.\tToday\tI am happy today.\n36\tWe have bread. We have cheese.\tand\tWe have bread and cheese.\n37\tI like mangoes.\tShe\tShe likes mangoes.\n38\tEric has a green cap.\tThey\tThey have green caps.\n39\tThe towel is on the chair.\tPlural\tThe towels are on the chair.\n40\tWe help our teacher every Friday.\tYesterday\tWe helped our teacher yesterday.\n41\tHe is opening his lunch box.\tQuestion\tIs he opening his lunch box?\n42\tNina likes fish.\tNegative\tNina doesn’t like fish.\n43\tThere are three pencils on the floor.\tSingular\tThere is a pencil on the floor.\n44\tThey play cards after dinner.\tNow\tThey are playing cards now.\n45\tJack can run quickly.\tNegative\tJack can’t run quickly.\n46\tLucy drinks juice at breakfast.\tQuestion\tDoes Lucy drink juice at breakfast?\n47\tI was scared yesterday.\tToday\tI am scared today.\n48\tWe have eggs. We have toast.\tand\tWe have eggs and toast.",
};

const selectedClass = localStorage.getItem('sentenceMasterClass') || '3pm';
const activeClass = SM_DATA_BY_CLASS[selectedClass] ? selectedClass : '3pm';
const SM_DATA = SM_DATA_BY_CLASS[activeClass];
const selectedCsvFile = `${activeClass.toUpperCase()} weekly built-in set (48 questions)`;
document.title = `${activeClass.toUpperCase()} · ${document.title.replace(/^3PM\s*·\s*/, '')}`;
</script>
<script>
let questions = [];
let currentIndex = 0;
let timerTimeout;

$(document).ready(function () {
    
    if (!selectedCsvFile) {
        alert('No CSV file selected. Please go back and choose a level.');
        window.location.href = 'index.html';
        return;
    }
    
    console.log('Loading CSV file:', selectedCsvFile);
    
    const url = selectedCsvFile + '?t=' + new Date().getTime();
    
    Promise.resolve(new Response(SM_DATA))
        .then(res => {
            if (!res.ok) {
                throw new Error(`Could not load ${selectedCsvFile} (Status: ${res.status})`);
            }
            return res.text();
        })
        .then(csv => {
            console.log('CSV loaded, first 200 chars:', csv.substring(0, 200));
            parseCSV(csv);
            
            if (questions.length === 0) {
                alert('No valid questions found in the CSV file. Please check the file format.');
                return;
            }
            
            console.log('Questions loaded successfully:', questions.length);
            showQuestion();
            
            timerTimeout = setTimeout(function() {
                showTimesUpModal();
            }, 600000);
            
            $('.timer-bar').on('animationend', function() {
                showTimesUpModal();
            });
        })
        .catch(error => {
            alert('Error loading CSV: ' + error.message);
            console.error('Fetch error:', error);
        });
});

function parseCSV(csv) {
    const lines = csv.split('\n');
    questions = [];

    for (let i = 1; i < lines.length; i++) {
        const line = lines[i].trim();
        if (line === '') continue;
        
        let parts = line.split('\t');
        
        if (parts.length < 4) {
            parts = line.split('\t');
        }
        
        if (parts.length >= 4) {
            const question = {
                original: parts[1] ? parts[1].trim() : '',
                changeTo: parts[2] ? parts[2].trim() : '',
                answer: parts[3] ? parts[3].trim() : ''
            };
            
            if (question.original && question.changeTo && question.answer) {
                questions.push(question);
            }
        }
    }

    if (questions.length > 0) {
        questions.sort(() => Math.random() - 0.5);
    }
}

function showQuestion() {
    if (currentIndex >= questions.length) {
        clearTimeout(timerTimeout);
        location.href = 'index.html'; // Changed from winner.html to index.html
        return;
    }

    const q = questions[currentIndex];

    $('#questionNumber').text(`Question ${currentIndex + 1} of ${questions.length}`);
    $('#originalSentence').text(q.original);
    $('#changeInstruction').text(`→ Change to: ${q.changeTo}`);
    $('#answerText').text(q.answer);

    $('#answerSection').hide();
    $('#showAnswerBtn').removeClass('hidden');
    $('#nextBtn').addClass('hidden');
    
    $('.question-container').scrollTop(0);
}

function showTimesUpModal() {
    clearTimeout(timerTimeout);
    $('#timesUpModal').fadeIn(300).css('display', 'flex');
    $('.timer-bar').css('animation-play-state', 'paused');
}

$('#showAnswerBtn').on('click', function () {
    $('#answerSection').slideDown(300, function() {
        $('.question-container').animate({
            scrollTop: $('.question-container')[0].scrollHeight
        }, 500);
    });
    $(this).addClass('hidden');
    $('#nextBtn').removeClass('hidden');
});

$('#nextBtn').on('click', function () {
    currentIndex++;
    showQuestion();
});

// Modal OK button click - NOW RETURNS TO INDEX.HTML
$('#modalOkBtn').on('click', function() {
    location.href = 'index.html'; // Changed from winner.html to index.html
});

// Also update the end of questions to go to index.html
// (Already changed in showQuestion function above)

window.addEventListener('beforeunload', function() {
    clearTimeout(timerTimeout);
});
</script>

</body>
</html>
